  "semantic-custom-light": {
    "color": {
      "surface": "var(--custom-background)",
      "surface-raised": "color-mix(in oklab, var(--custom-background) 35%, #ffffff)",
      "surface-sunken": "color-mix(in oklab, var(--custom-background) 94%, var(--custom-text))",
      "surface-hover": "color-mix(in oklab, var(--custom-background) 92%, var(--custom-text))",
      "surface-track": "color-mix(in oklab, var(--custom-background) 94%, var(--custom-text))",
      "surface-selected": "color-mix(in oklab, var(--custom-background) 35%, #ffffff)",
      "fg": "var(--custom-text)",
      "fg-secondary": "color-mix(in oklab, var(--custom-text) 80%, var(--custom-background))",
      "fg-muted": "color-mix(in oklab, var(--custom-text) 68%, var(--custom-background))",
      "border": "color-mix(in oklab, var(--custom-text) 15%, var(--custom-background))",
      "border-strong": "color-mix(in oklab, var(--custom-text) 25%, var(--custom-background))",
      "action": "var(--custom-text)",
      "action-hover": "color-mix(in oklab, var(--custom-text) 85%, var(--custom-background))",
      "action-subtle": "color-mix(in oklab, var(--custom-text) 18%, var(--custom-background))",
      "action-fg": "var(--custom-link)",
      "on-action": "var(--custom-background)",
      "danger": "{color.danger.600}",
      "danger-hover": "{color.danger.700}",
      "danger-subtle": "{color.danger.100}",
      "danger-fg": "{color.danger.700}",
      "on-danger": "{color.white}",
      "warning-subtle": "{color.warning.100}",
      "warning-fg": "{color.warning.800}",
      "focus": "color-mix(in oklab, var(--custom-text) 60%, var(--custom-background))",
      "scrim": "{color.neutral.950}",
      "cover": "color-mix(in oklab, var(--custom-text) 70%, var(--custom-background))",
      "on-cover": "var(--custom-background)",
      "on-cover-muted": "color-mix(in oklab, var(--custom-background) 80%, var(--custom-text))"
    }
  },
