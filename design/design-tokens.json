{
  "$meta": {
    "name": "Carrel",
    "source": "refactoring-ui skill, Workflow A",
    "personality": {
      "formality": "serious",
      "era": "classic",
      "density": "spacious",
      "grey-temperature": "cool, barely"
    },
    "generated": {
      "neutral": "generate_palette.py --grey --temperature cool --grey-saturation 4 --extended --name neutral --darkest 18 --lightest 94",
      "danger": "generate_palette.py --base '#c53030' --toward cool --name danger",
      "warning": "generate_palette.py --base '#c27c0e' --name warning"
    },
    "pairs-note": "Only real text-on-background pairs. Borders and dividers are not text.",
    "track-note": "surface-track and surface-selected draw segmented controls: the selected segment has to stand out from its track in every theme, which surface-sunken and surface-raised do not in dark (both neutral.900).",
    "font-note": "The sans stack names each platform's interface font instead of system-ui, which resolves to whatever font the desktop is set to (on Linux possibly a monospace face; on Windows with an East Asian display language, that locale's UI font).",
    "accent-note": "There is no hue for actions: the primary button, the current item and focus are drawn in the theme's own greys, so the book covers are the only colour on screen. Hue is kept for danger and warning, where it carries meaning.",
    "custom-note": "semantic-custom-light and semantic-custom-dark derive every token from the three colours of a theme the reader makes (--custom-background, --custom-text, --custom-link), mixed in oklab. Their contrast can't be checked here; the theme editor warns when the text or the links fall below 4.5:1 as the reader picks the colours."
  },
